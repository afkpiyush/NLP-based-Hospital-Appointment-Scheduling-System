# Environment Configuration
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

# Database Configuration
DATABASE_TYPE=mongodb
MONGODB_URL=mongodb://localhost:27017/healthcare_assistant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# LLM Configuration
LLM_PROVIDER=groq
GROQ_API_KEY=test_key_for_demo
GROQ_MODEL=llama3-70b-8192
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Translation Configuration
GOOGLE_TRANSLATE_API_KEY=
ENABLE_TRANSLATION=true

# Application Configuration
APP_NAME=Healthcare Assistant
APP_VERSION=1.0.0
API_BASE_URL=http://localhost:8003
FRONTEND_URL=http://localhost:8501

# Security
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
REQUIRE_API_KEY=false

# CORS
CORS_ORIGINS=["http://localhost:8501", "http://localhost:3000", "http://127.0.0.1:8501"]

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8003
WORKERS=4

# Feature Flags
ENABLE_VOICE_INPUT=false
ENABLE_VIDEO_CONSULTATION=false
ENABLE_PRESCRIPTION=false
ENABLE_MEDICAL_RECORDS=false
ENABLE_TELEMEDICINE=false

# Chat Configuration
CHAT_MAX_MESSAGE_LENGTH=5000
CHAT_INACTIVITY_TIMEOUT=3600

# Email Configuration (optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@healthcare-assistant.com
ENABLE_EMAIL_NOTIFICATIONS=false

# Redis Configuration (optional)
REDIS_URL=redis://localhost:6379/0
ENABLE_CACHING=true
CACHE_TTL=3600

# Rate Limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=3600

# Logging
LOG_FILE=logs/app.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5
