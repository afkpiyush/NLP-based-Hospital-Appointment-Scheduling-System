# Application Environment
ENVIRONMENT=development
DEBUG=true

# Database Configuration
DATABASE_TYPE=mongodb  # mongodb or postgresql

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=healthcare_assistant

# PostgreSQL (if using)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=healthcare_assistant

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

# LLM Configuration
LLM_PROVIDER=groq  # groq, openai, or anthropic
LLM_MODEL=llama3-70b-8192
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# Translation Service
USE_GOOGLE_TRANSLATE=false
GOOGLE_TRANSLATE_API_KEY=your_google_translate_key

# External APIs
GOOGLE_MAPS_API_KEY=your_google_maps_key

# Authentication
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_EXPIRATION_HOURS=24

# Email Configuration
EMAIL_ENABLED=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
FROM_EMAIL=noreply@healthcareassistant.com

# API Settings
API_TIMEOUT_SECONDS=30
MAX_REQUEST_SIZE_MB=10
RATE_LIMIT_PER_HOUR=100
REQUIRE_API_KEY=false

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:8501,http://localhost:8000

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Feature Flags
ENABLE_VOICE_INPUT=false
ENABLE_VIDEO_CONSULTATION=false
ENABLE_PRESCRIPTION_GENERATION=false
ENABLE_MEDICAL_RECORDS=true
ENABLE_TELEMEDICINE=false

# Chat Configuration
MAX_CHAT_MESSAGE_LENGTH=5000
CHAT_INACTIVITY_TIMEOUT_MINUTES=60

# Appointment Settings
MIN_APPOINTMENT_ADVANCE_HOURS=1
MAX_APPOINTMENT_ADVANCE_DAYS=90
APPOINTMENT_CONFIRMATION_EMAIL=true
